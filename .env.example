# WalletConnect Cloud project id — optional on Vercel Hobby.
# Without it, the Connect button still works as a local Sepolia stub.
# Create one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Set to "true" to hint the UI that Sepolia testnet is expected (default).
NEXT_PUBLIC_ENABLE_TESTNETS=true

# Public Cloudflare Worker chat proxy (no visitor login).
# After `npx wrangler deploy` in workers/xsnow-chat, set the workers.dev URL.
# Inlined at static-export build time.
NEXT_PUBLIC_CHAT_API_URL=
