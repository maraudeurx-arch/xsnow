# WalletConnect Cloud / Reown project id (32 hex chars).
# Required for the header Connect button to open RainbowKit + WalletConnect
# (QR on desktop, deep link on iPhone Safari). Without it, Connect explains
# that the wallet is not configured — it does not fake a guest session.
# Create a free project: https://cloud.reown.com  (WalletConnect Cloud)
# Then set the same name as a GitHub Actions *variable* so Pages builds inline it:
#   Settings → Secrets and variables → Actions → Variables
#   NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<32-char id>
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Set to "true" (default if unset) to keep Sepolia as the expected testnet.
NEXT_PUBLIC_ENABLE_TESTNETS=true

# Public Cloudflare Worker chat proxy (no visitor login).
# Inlined at static-export build time. Defaults to the deployed Worker if unset.
NEXT_PUBLIC_CHAT_API_URL=https://xsnow-chat.xsnowopc.workers.dev

# Reverse geocode via the same Worker (`/geo`). Optional — the browser
# falls back to BigDataCloud if this is unset or unreachable.
NEXT_PUBLIC_GEO_API_URL=https://xsnow-chat.xsnowopc.workers.dev/geo
