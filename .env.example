# WalletConnect Cloud / Reown project id (32 hex chars).
# Required for the header Connect button to open RainbowKit + WalletConnect
# (QR on desktop, deep link on iPhone Safari). Without it, Connect explains
# that the wallet is not configured — it does not fake a guest session.
# Create a free project: https://cloud.reown.com  (WalletConnect Cloud)
# Then set the same name as a GitHub Actions *variable* so Pages builds inline it:
#   Settings → Secrets and variables → Actions → Variables
#   NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<32-char id>
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Default true if unset: also advertise Sepolia as an extra optional chain.
# Ethereum mainnet (and Base) are always included so mobile WalletConnect can
# connect; Sepolia is not required for a successful session.
NEXT_PUBLIC_ENABLE_TESTNETS=true

# Public Cloudflare Worker chat proxy (no visitor login).
# Inlined at static-export build time. Defaults to the deployed Worker if unset.
NEXT_PUBLIC_CHAT_API_URL=https://xsnow-chat.xsnowopc.workers.dev

# Reverse geocode via the same Worker (`/geo`). Optional — the browser
# falls back to BigDataCloud if this is unset or unreachable.
NEXT_PUBLIC_GEO_API_URL=https://xsnow-chat.xsnowopc.workers.dev/geo

# Neighbourhood news (`GET /news` on the same Worker). Optional override.
# NEXT_PUBLIC_NEWS_API_URL=https://xsnow-chat.xsnowopc.workers.dev/news

# Accueil partner slots under Nouvelles du Quartier (labeled Publicité, never fake news).
# Soft-launch: rotating house ads (register / share / local partner) until real deals.
# Do not claim live ad revenue. Set false/0/off to hide. Provider:
#   placeholder (default) | adsense | none
NEXT_PUBLIC_ADS_ENABLED=true
NEXT_PUBLIC_ADS_PROVIDER=placeholder
# When provider=adsense, also set a publisher id and unit ids (inlined at build):
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_NEWS_MID=
# NEXT_PUBLIC_ADSENSE_SLOT_NEWS_BOTTOM=

# Public site is https://opencommunity.app/ (GitHub Pages + CNAME).
# Production / Pages builds set CUSTOM_DOMAIN=1 (empty Next basePath).
# CUSTOM_DOMAIN=0 keeps /xsnow for the old github.io project URL locally.
# CUSTOM_DOMAIN=1
# NEXT_PUBLIC_CUSTOM_DOMAIN=1

# --- Cloudflare Worker secrets (never NEXT_PUBLIC, never commit) ---
# Owner inbox: submitting Vos idées POSTs to the Worker, which emails
# opencommunity.opc@gmail.com via Resend. Destination is hardcoded in code.
#   cd workers/xsnow-chat
#   npx wrangler secret put RESEND_API_KEY
# Optional verified From (Resend domain). Default: beth.t@example.com
#   npx wrangler secret put IDEAS_FROM_EMAIL
# Optional compile page (GET /ideas):
#   npx wrangler secret put IDEAS_OWNER_SECRET
# Then: npx wrangler deploy
